{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/rehydrate-on-compact.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\scripts\\rehydrate-on-compact.ps1\"",
            "timeout": 10,
            "statusMessage": "Restoring session continuity",
            "additionalContextLimit": 2000
          }
        ]
      }
    ]
  }
}
